<Window x:Class="AgendamentoInterface.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AgendamentoInterface"
        mc:Ignorable="d"
        Title="SACR - Sistema de Agendamento de Controle de Recursos." Height="450" Width="800">
    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <StackPanel Grid.Column="0" 
                    Margin="0,0,15,0">
            <TextBlock Text="Novo Agendamento" 
                       FontSize="20" 
                       FontWeight="Bold" 
                       Margin="0,0,0,20"/>

            <Label Content="Recurso:"/>
            <TextBox x:Name="txtRecurso" 
                     Margin="0,0,0,10" 
                     Padding="3"/>

            <Label Content="Responsável:"/>
            <TextBox x:Name="txtResponsavel" 
                     Margin="0,0,0,10"
                     Padding="3"/>

            <Label Content="Início:"/>
            <DatePicker x:Name="dpInicio"
                        Margin="0,0,0,10"/>

            <Label Content="Término:"/>
            <DatePicker x:Name="dpFim"
                        Margin="0,0,0,20"/>

            <Button Content="Confirmar Reserva"
                    Click="BtnReservar_Click" 
                    Background="#007ACC"
                    Foreground="White" 
                    Height="40" 
                    FontWeight="Bold"/>

            <TextBlock x:Name="txtStatus"
                       Margin="0,15,0,0" 
                       TextWrapping="Wrap" 
                       TextAlignment="Center"/>
        </StackPanel>
        
        <DockPanel Grid.Column="1">
            <TextBlock DockPanel.Dock="Top"
                       Text="Monitoramento em Tempo Real" 
                       FontSize="18" 
                       Margin="0,0,0,10"/>
            <Button DockPanel.Dock="Bottom" 
                    Content="Atualizar Lista" 
                    Click="BtnAtualizar_Click" 
                    Margin="0,10,0,0" 
                    Height="30"/>
            <DataGrid x:Name="dgAgendamentos" 
                      AutoGenerateColumns="True" 
                      IsReadOnly="True" 
                      AlternatingRowBackground="#F0F0F0"/>
        </DockPanel>
    </Grid>
</Window>
